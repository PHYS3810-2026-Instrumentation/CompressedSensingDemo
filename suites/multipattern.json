{
	"name" : "MultiPatterns",
	"folder" : "./suites/runs/MultiPatterns/",
	"notes" : "Generates comparisons of the main vectorization patterns used. Each pattern utilizes the same sample for each sample percent",
	
	"commands" : [
		[
			"prep --crop --resize w=32 --no-save --mono",
			"sample [SAMPLE]% --out [FOLDER]/.sample[SAMPLE].png"
		],
		[
			"vector [FOLDER]/.sample[SAMPLE].png --pattern [PATTERN] --out [FOLDER]/.sample[SAMPLE]_[PATTERN].csv"
		],
		[
			"prep [FILE] --crop --resize w=32 --normalise --monochrome --no-save",
			"vector --pattern [PATTERN] --no-save",
			"sample --mask [FOLDER]/.sample[SAMPLE]_[PATTERN].csv --no-save",
			"reconstruct --basis [BASIS] --no-save",
			"devector --out [FOLDER]/[SAMPLE]_[PATTERN]_[BASIS]_[FILE-ID].png"
		]
	],
	
	"files" : [
		"./testdata/*.jpg"
	],
	
	"patterns" : [
		"xy",
		"theta",
		"snake_square"
	],
	
	"samples" : [
		10, 25, 50, 75
	],
	
	"bases" : [
		"discrete-cosine",
		"fourier"
	]
}