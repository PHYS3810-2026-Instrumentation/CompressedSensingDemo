{
	"name" : "GeneralSet",
	"folder" : "./run/GeneralSuite/",
	"notes" : "",
	
	"commands" : [
		[
			"prep ./blank.jpg --crop --resize w=32 --no-save --monochrome",
			"sample [SAMPLE]% --out [FOLDER]/.sample[SAMPLE].jpg",
			"vector --pattern [PATTERN] --out [FOLDER]/.sample[SAMPLE]_[PATTERN].csv"
		],
		[
			"prep [FILE] --crop --resize w=32 --normalise --monochrome --no-save",
			"vector --pattern [PATTERN] --no-save",
			"sample --mask [FOLDER]/.sample[SAMPLE]_[PATTERN].csv --no-save",
			"reconstruct --basis [BASIS] --no-save",
			"devector --out [FOLDER]/[SAMPLE]_[PATTERN]_[FILE-ID].png"
		]
	],
	
	"files" : [
		"./testdata/*.jpg"
	],
	
	"patterns" : [
		"xy",
		"theta",
		"snake_square"
	],
	
	"samples" : [
		10, 25, 50, 75
	],
	
	"bases" : [
		"discrete-cosine",
		"fourier",
		"hadamard",
		"ihdd"
	]
}