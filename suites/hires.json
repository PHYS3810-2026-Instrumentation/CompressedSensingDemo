{
	"name" : "hires",
	"folder" : "./suites/run/hires",
	"notes" : "Higher resolution (64x64) reconstructions with DCT, FFT, HDD, IHDD. Expected to take a long time.",
	
	"commands" : [
		[
			"prep --crop --resize w=64 --no-save",
			"sample [SAMPLE]% --out [FOLDER]/_sample[SAMPLE].png"
		],

		[
            "prep [FOLDER]/.sample[SAMPLE].png --mono --no-save",
			"vector --pattern [PATTERN] --out [FOLDER]/.sample[SAMPLE]_[PATTERN].csv"
		],

		[
			"prep [FILE] --crop --resize w=64 --mono --no-alpha --normalise --out [FOLDER]/_[FNAME]_[FILE-ID].png"
		],

		[
            "prep [FOLDER]/_[FNAME]_[FILE-ID].png --normalise --mono --no-alpha --no-save",
			"vector --pattern [PATTERN] --no-save",
			"sample --mask [FOLDER]/.sample[SAMPLE]_[PATTERN].csv --no-save",
			"reconstruct --basis [BASIS] --no-save --persist",
			"devector --out [FOLDER]/[SAMPLE]_[PATTERN]_[BASIS]_[FILE-ID].png"
		]
	],
	
	"files" : [
		"./suitedata/gamma/*.png",
		"./suitedata/infrared/*.png",
		"./suitedata/optical/*.png"
	],
	
	"patterns" : [
		"xy",
		"theta"
	],
	
	"samples" : [
		"10", "25", "50", "75"
	],
	
	"bases" : [
		"dct",
		"fft",
		"hadamard",
		"ihdd"
	]
}
